{
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/build/Debug/STM32F103-GPIO-KEY.elf",//可执行文件的路径，你看你自己的是在哪
            "name": "cmsis-dap",                                          //用的什么仿真stlink还是jlink
            "request": "launch",
            "type": "cortex-debug",
